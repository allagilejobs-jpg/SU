Dialogue: 0,0:00:00.00,0:00:00.80,Base,,0,0,0,,MY {\c&H6DB8E8&}FAVORITE{\c&HFFFFFF&} MOMENT THAT
Dialogue: 0,0:00:00.80,0:00:02.84,Base,,0,0,0,,TODAY WAS HELPING THOSE
Dialogue: 0,0:00:02.84,0:00:03.84,Base,,0,0,0,,KIDS AT THE CENTER.
Dialogue: 0,0:00:04.26,0:00:04.82,Base,,0,0,0,,I CAN FEEL THEIR
Dialogue: 0,0:00:04.82,0:00:05.82,Base,,0,0,0,,STRUGGLES, BUT THEY HAVE
Dialogue: 0,0:00:05.82,0:00:06.80,Base,,0,0,0,,THE WORDS IN THEIR
Dialogue: 0,0:00:06.80,0:00:07.44,Base,,0,0,0,,HEAD, BUT THEY JUST
Dialogue: 0,0:00:07.44,0:00:08.68,Base,,0,0,0,,CAN'T SAY IT. YEAH.
Dialogue: 0,0:00:09.14,0:00:10.00,Base,,0,0,0,,DO YOU REMEMBER WHAT
Dialogue: 0,0:00:10.00,0:00:11.34,Base,,0,0,0,,THAT FELT LIKE? I
Dialogue: 0,0:00:11.34,0:00:12.04,Base,,0,0,0,,FELT LIKE A BALL
Dialogue: 0,0:00:12.04,0:00:12.84,Base,,0,0,0,,STUCK IN YOUR THROAT.
Dialogue: 0,0:00:13.46,0:00:14.66,Base,,0,0,0,,DOES IT GET FRUSTRATING?
Dialogue: 0,0:00:14.96,0:00:15.58,Base,,0,0,0,,YEAH, IT DOES GET
Dialogue: 0,0:00:15.58,0:00:16.66,Base,,0,0,0,,FRUSTRATING AFTER A WHILE.
Dialogue: 0,0:00:17.78,0:00:19.04,Base,,0,0,0,,I MEAN, YOU'RE LUCKY
Dialogue: 0,0:00:19.04,0:00:20.08,Base,,0,0,0,,BECAUSE YOU GOT LANGUAGE,
Dialogue: 0,0:00:20.20,0:00:20.88,Base,,0,0,0,,BUT THERE ARE KIDS
Dialogue: 0,0:00:20.88,0:00:21.76,Base,,0,0,0,,AT YOUR AGE THAT
Dialogue: 0,0:00:21.76,0:00:23.02,Base,,0,0,0,,CAN'T, STILL CAN'T SPEAK.
Dialogue: 0,0:00:24.14,0:00:25.06,Base,,0,0,0,,DO I HAVE {\c&H6DB8E8&}AUTISM{\c&HFFFFFF&}
Dialogue: 0,0:00:25.06,0:00:26.48,Base,,0,0,0,,STILL? DO YOU FEEL
Dialogue: 0,0:00:26.48,0:00:27.12,Base,,0,0,0,,LIKE YOU STILL HAVE
Dialogue: 0,0:00:27.12,0:00:28.66,Base,,0,0,0,,{\c&H6DB8E8&}AUTISM?{\c&HFFFFFF&} YEAH, SOMETIMES I
Dialogue: 0,0:00:28.66,0:00:29.68,Base,,0,0,0,,DO, BUT SOMETIMES I
Dialogue: 0,0:00:29.68,0:00:30.82,Base,,0,0,0,,DON'T. WHAT DO YOU
Dialogue: 0,0:00:30.82,0:00:32.16,Base,,0,0,0,,MEAN? WHEN I ACT
Dialogue: 0,0:00:32.16,0:00:33.04,Base,,0,0,0,,A LITTLE CRAZY, THAT'S
Dialogue: 0,0:00:33.04,0:00:34.18,Base,,0,0,0,,SOMETIMES WHEN I START
Dialogue: 0,0:00:34.18,0:00:34.82,Base,,0,0,0,,TO CRY AND FEEL
Dialogue: 0,0:00:34.82,0:00:35.74,Base,,0,0,0,,SENSITIVE. THAT'S WHEN I
Dialogue: 0,0:00:35.74,0:00:36.46,Base,,0,0,0,,FEEL LIKE I HAVE
Dialogue: 0,0:00:36.46,0:00:37.82,Base,,0,0,0,,{\c&H6DB8E8&}AUTISM.{\c&HFFFFFF&} WHAT ABOUT FRIENDSHIP?
Dialogue: 0,0:00:39.04,0:00:39.98,Base,,0,0,0,,YEAH, THAT KIND OF
Dialogue: 0,0:00:39.98,0:00:40.76,Base,,0,0,0,,FEELS LIKE I HAVE
Dialogue: 0,0:00:40.76,0:00:41.62,Base,,0,0,0,,{\c&H6DB8E8&}AUTISM{\c&HFFFFFF&} TOO. WHEN I
Dialogue: 0,0:00:41.62,0:00:42.82,Base,,0,0,0,,ACT COOL AROUND {\c&H6DB8E8&}FRIENDS{\c&HFFFFFF&}
Dialogue: 0,0:00:42.82,0:00:44.56,Base,,0,0,0,,AT THAT MOMENT, I
Dialogue: 0,0:00:44.56,0:00:45.32,Base,,0,0,0,,DON'T SEEM I REALLY
Dialogue: 0,0:00:45.32,0:00:46.40,Base,,0,0,0,,HAVE IT THEN. BUT
Dialogue: 0,0:00:46.40,0:00:47.44,Base,,0,0,0,,DO YOU SOMETIMES FEEL
Dialogue: 0,0:00:47.44,0:00:49.12,Base,,0,0,0,,LIKE YOU DON'T HAVE
Dialogue: 0,0:00:49.12,0:00:50.14,Base,,0,0,0,,{\c&H6DB8E8&}FRIENDS{\c&HFFFFFF&} BECAUSE YOU HAVE
Dialogue: 0,0:00:50.14,0:00:52.32,Base,,0,0,0,,{\c&H6DB8E8&}AUTISM?{\c&HFFFFFF&} YEAH. YOU DO?
Dialogue: 0,0:00:52.58,0:00:53.40,Base,,0,0,0,,YEAH, SOMETIMES I SEE
Dialogue: 0,0:00:53.40,0:00:54.32,Base,,0,0,0,,PEOPLE WHO LIKE ME
Dialogue: 0,0:00:54.32,0:00:55.46,Base,,0,0,0,,SOMETIMES BECAUSE I HAVE
Dialogue: 0,0:00:55.46,0:00:57.02,Base,,0,0,0,,{\c&H6DB8E8&}AUTISM.{\c&HFFFFFF&} RIGHT. WHEN YOU
Dialogue: 0,0:00:57.02,0:00:57.80,Base,,0,0,0,,WERE LITTLE, YOU WERE
Dialogue: 0,0:00:57.80,0:00:58.68,Base,,0,0,0,,REALLY HAVING A HARD
Dialogue: 0,0:00:58.68,0:00:59.80,Base,,0,0,0,,TIME CONNECTING AND MAKING
Dialogue: 0,0:00:59.80,0:01:01.82,Base,,0,0,0,,{\c&H6DB8E8&}FRIENDS.{\c&HFFFFFF&} THEY DIDN'T UNDERSTAND
Dialogue: 0,0:01:01.82,0:01:02.44,Base,,0,0,0,,WHO YOU WERE.
Dialogue: 0,0:01:04.18,0:01:05.66,Base,,0,0,0,,RIGHT? YEAH. WHAT DID
Dialogue: 0,0:01:05.66,0:01:06.14,Base,,0,0,0,,THEY ASK YOU TO
Dialogue: 0,0:01:06.14,0:01:07.52,Base,,0,0,0,,SAY? I ASKED YOU
Dialogue: 0,0:01:07.52,0:01:08.18,Base,,0,0,0,,IN THE BOOTY HOLE.
Dialogue: 0,0:01:08.68,0:01:09.54,Base,,0,0,0,,ARE YOU KIDDING ME?
Dialogue: 0,0:01:10.02,0:01:10.78,Base,,0,0,0,,YOU HAD BOYS THAT
Dialogue: 0,0:01:10.78,0:01:11.60,Base,,0,0,0,,WERE SENDING YOU UP
Dialogue: 0,0:01:11.60,0:01:12.92,Base,,0,0,0,,TO GIRLS SAYING DISGUSTING
Dialogue: 0,0:01:12.92,0:01:13.62,Base,,0,0,0,,THINGS. THEY MADE ME
Dialogue: 0,0:01:13.62,0:01:14.10,Base,,0,0,0,,GO IN THE GIRLS'
Dialogue: 0,0:01:14.26,0:01:15.50,Base,,0,0,0,,BATHROOM. I DID TO
Dialogue: 0,0:01:15.50,0:01:16.12,Base,,0,0,0,,MAKE {\c&H6DB8E8&}FRIENDS.{\c&HFFFFFF&} I DIDN'T.
Dialogue: 0,0:01:23.70,0:01:24.94,Base,,0,0,0,,ANYTIME YOU HAVE SOMEONE
Dialogue: 0,0:01:24.94,0:01:26.80,Base,,0,0,0,,THAT DOESN'T REALLY UNDERSTAND
Dialogue: 0,0:01:26.80,0:01:27.52,Base,,0,0,0,,YOU, THEY'RE NOT GOING
Dialogue: 0,0:01:27.52,0:01:28.24,Base,,0,0,0,,TO REALLY KNOW HOW
Dialogue: 0,0:01:28.24,0:01:28.90,Base,,0,0,0,,TO {\c&H6DB8E8&}LOVE{\c&HFFFFFF&} YOU BECAUSE
Dialogue: 0,0:01:28.90,0:01:29.42,Base,,0,0,0,,THEY DON'T KNOW WHO
Dialogue: 0,0:01:29.42,0:01:30.34,Base,,0,0,0,,YOU ARE. I DON'T
Dialogue: 0,0:01:30.34,0:01:30.86,Base,,0,0,0,,WANT YOU TO FEEL
Dialogue: 0,0:01:30.86,0:01:32.16,Base,,0,0,0,,SAD ABOUT NOT HAVING
Dialogue: 0,0:01:32.16,0:01:34.86,Base,,0,0,0,,25, 30 {\c&H6DB8E8&}FRIENDS{\c&HFFFFFF&} BECAUSE
Dialogue: 0,0:01:34.86,0:01:35.50,Base,,0,0,0,,YOU ONLY REALLY NEED
Dialogue: 0,0:01:35.50,0:01:36.28,Base,,0,0,0,,ONE OR TWO GOOD
Dialogue: 0,0:01:36.28,0:01:37.80,Base,,0,0,0,,{\c&H6DB8E8&}FRIENDS,{\c&HFFFFFF&} RIGHT? YEAH. MOM
Dialogue: 0,0:01:37.80,0:01:39.22,Base,,0,0,0,,HAS ANTI -TERRY. I
Dialogue: 0,0:01:39.22,0:01:40.32,Base,,0,0,0,,HAVE {\c&H6DB8E8&}WONDER.{\c&HFFFFFF&} YOU HAVE
Dialogue: 0,0:01:40.32,0:01:41.26,Base,,0,0,0,,{\c&H6DB8E8&}WONDER.{\c&HFFFFFF&} YOU ALWAYS LOOK
Dialogue: 0,0:01:41.26,0:01:41.84,Base,,0,0,0,,OUT FOR ME. YOU
Dialogue: 0,0:01:41.84,0:01:43.02,Base,,0,0,0,,WOULD {\c&H6DB8E8&}WONDER{\c&HFFFFFF&} EVER PUT
Dialogue: 0,0:01:43.02,0:01:43.58,Base,,0,0,0,,YOU IN A BAD
Dialogue: 0,0:01:43.58,0:01:44.96,Base,,0,0,0,,POSITION WHERE YOU WERE
Dialogue: 0,0:01:44.96,0:01:46.00,Base,,0,0,0,,EITHER IN HARM'S WAY
Dialogue: 0,0:01:46.00,0:01:47.52,Base,,0,0,0,,OR YOU DID SOMETHING
Dialogue: 0,0:01:47.52,0:01:49.12,Base,,0,0,0,,INAPPROPRIATE. HE WOULD NEVER
Dialogue: 0,0:01:49.12,0:01:50.44,Base,,0,0,0,,DO THAT. NO. THAT'S
Dialogue: 0,0:01:50.44,0:01:51.88,Base,,0,0,0,,A {\c&H6DB8E8&}REAL{\c&HFFFFFF&} {\c&H6DB8E8&}FRIEND.{\c&HFFFFFF&} THAT
Dialogue: 0,0:01:51.88,0:01:53.32,Base,,0,0,0,,IS HOW YOU {\c&H6DB8E8&}JUDGE{\c&HFFFFFF&}
Dialogue: 0,0:01:53.32,0:01:54.36,Base,,0,0,0,,WHO IS YOUR {\c&H6DB8E8&}FRIEND,{\c&HFFFFFF&}
Dialogue: 0,0:01:54.92,0:01:55.98,Base,,0,0,0,,WHO HAS YOUR {\c&H6DB8E8&}BACK,{\c&HFFFFFF&}
Dialogue: 0,0:01:56.26,0:01:57.34,Base,,0,0,0,,WHO'S LOOKING OUT FOR
Dialogue: 0,0:01:57.34,0:01:57.52,Base,,0,0,0,,YOU.
